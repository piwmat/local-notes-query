#!/usr/bin/env python
"""Extract embeddings from Smart Connections .ajson to embeddings.json (best you/ only)."""
import json, os, sys
from pathlib import Path

VAULT = Path(r"C:\Users\Mateusz\Desktop\Notes")
MULTI = VAULT / ".smart-env" / "multi"
OUT   = VAULT / "best you" / "embeddings.json"
EXPECTED_DIM = 384

if not MULTI.is_dir():
    print(f"Not found: {MULTI}"); sys.exit(1)

notes = {}
count = 0
parse_errors = 0
skip_dim = 0

dec = json.JSONDecoder()
for fname in sorted(os.listdir(MULTI)):
    if not fname.endswith(".ajson"):
        continue
    fpath = MULTI / fname
    with open(fpath, encoding="utf-8") as f:
        content = f.read()
    i, n, line_no = 0, len(content), 0
    while i < n:
        line_no += 1
        nl = content.find("\n", i)
        line_end = nl if nl != -1 else n
        line = content[i:line_end]
        i = line_end + 1 if nl != -1 else n
        # Each .ajson line is: "key": {value-object},
        # Strip trailing comma + whitespace, wrap as {"key": value}, parse.
        s = line.strip().rstrip(",").rstrip()
        if not s:
            continue
        try:
            obj, _end = dec.raw_decode("{" + s + "}")
        except json.JSONDecodeError as e:
            parse_errors += 1
            print(f"  parse err {fname}:{line_no}: {e.msg}", file=sys.stderr)
            continue
        if not isinstance(obj, dict) or len(obj) != 1:
            continue
        key, val = next(iter(obj.items()))
        if not key.startswith("smart_sources:"):
            continue
        note_path = val.get("path", "")
        if not note_path.startswith("best you/"):
            continue
        embs = val.get("embeddings", {})
        model_key, vec = None, None
        for mk, emb in embs.items():
            if isinstance(emb, dict) and emb.get("vec"):
                model_key, vec = mk, emb["vec"]
                break
        if vec and len(vec) == EXPECTED_DIM:
            notes[note_path] = {"path": note_path, "vec": vec, "model": model_key}
            count += 1
        elif vec:
            skip_dim += 1
            print(f"  skip {note_path}: dim={len(vec)} (expected {EXPECTED_DIM})", file=sys.stderr)

OUT.parent.mkdir(parents=True, exist_ok=True)
data = {"model": "TaylorAI/bge-micro-v2", "dim": EXPECTED_DIM, "notes": list(notes.values())}
with open(OUT, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False)

model_key = next((n["model"] for n in data["notes"] if n.get("model")), "?")
print(f"Extracted {count} notes -> {OUT}")
print(f"  Model: {model_key}, Dim: {EXPECTED_DIM}")
if parse_errors:
    print(f"  Parse errors: {parse_errors}", file=sys.stderr)
if skip_dim:
    print(f"  Skipped dim-mismatch: {skip_dim}", file=sys.stderr)