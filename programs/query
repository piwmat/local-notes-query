class Embedder:

    _inst = None

    def __init__(self):

        self.tok = Tokenizer.from_file(str(_SNAP_DIR / "tokenizer.json"))

        self.tok.enable_truncation(max_length=512)

        self.tok.enable_padding(pad_id=0, pad_token="[PAD]", length=512)

        self.sess = ort.InferenceSession(str(_SNAP_DIR / "onnx" / "model_quantized.onnx"))

    @classmethod

    def get(cls):

        if not cls._inst: cls._inst = cls()

        return cls._inst

    def embed(self, texts):

        if isinstance(texts, str): texts = [texts]

        enc = self.tok.encode_batch(texts)

        ids = np.array([e.ids for e in enc], dtype=np.int64)

        mask = np.array([e.attention_mask for e in enc], dtype=np.int64)

        ttype = np.array([e.type_ids for e in enc], dtype=np.int64)

        out = self.sess.run(None, {"input_ids": ids, "attention_mask": mask, "token_type_ids": ttype})

        last = out[0]

        m3d = np.expand_dims(mask, axis=-1).astype(np.float32)

        pooled = (last * m3d).sum(axis=1) / m3d.sum(axis=1).clip(min=1e-9)

        norm = np.linalg.norm(pooled, axis=1, keepdims=True)

        return pooled / norm.clip(min=1e-9)



# ── NoteStore ──────────────────────────────────────────────────────────

class NoteStore:

    def __init__(self):

        data = json.loads(EMBEDDINGS.read_text(encoding="utf-8"))

        self.paths = [n["path"] for n in data["notes"]]

        self.vecs = np.array([n["vec"] for n in data["notes"]], dtype=np.float32)

    def search(self, query, k=10):

        qv = Embedder.get().embed(query)[0]

        sims = self.vecs @ qv

        idx = np.argsort(-sims)[:k]

        return [(self.paths[i], float(sims[i])) for i in idx]



# ── Keyword MCP (fail-soft) ────────────────────────────────────────────

MCP_CMD  = "node"

MCP_ARGS = ["C:/smart-connections-mcp/dist/index.js"]

MCP_ENV  = {**os.environ, "SMART_VAULT_PATH": str(Path.home() / "Desktop" / "Notes")}



_MCP_PROC = None
_MCP_INITIALIZED = False

_MCP_QUEUE = queue.Queue()



def _mcp_start():

    global _MCP_PROC

    while True:

        try: _MCP_QUEUE.get_nowait()

        except queue.Empty: break

    _MCP_PROC = subprocess.Popen([MCP_CMD]+MCP_ARGS, stdin=subprocess.PIPE,

        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=MCP_ENV,

        text=True, encoding='utf-8', bufsize=1)

    threading.Thread(target=_mcp_pump, args=(_MCP_PROC,), daemon=True).start()



def _mcp_pump(proc):

    for line in proc.stdout:

        line = line.strip()

        if not line: continue

        try: _MCP_QUEUE.put(json.loads(line))

        except Exception: pass



def _mcp_batch(calls, timeout=15):

    """N tools/call sent in one write, wait for all ids (parallel). Fail-soft."""

    global _MCP_PROC

    if _MCP_PROC is None or _MCP_PROC.poll() is not None:

        _mcp_start()

    CRLF = "\r\n"

    parts = []

    global _MCP_INITIALIZED

    if not _MCP_INITIALIZED:

        parts.extend([

            json.dumps({"jsonrpc":"2.0","id":1,"method":"initialize",

                "params":{"protocolVersion":"2024-11-05","capabilities":{},

                          "clientInfo":{"name":"qc","version":"1.0"}}}),

            json.dumps({"jsonrpc":"2.0","method":"notifications/initialized"}),

        ])

    for i, (method, params) in enumerate(calls, start=2):

        parts.append(json.dumps({"jsonrpc":"2.0","id":i,"method":"tools/call",

            "params":{"name":method,"arguments":params}}))

    try:

        _MCP_PROC.stdin.write(CRLF.join(parts) + CRLF)

        _MCP_PROC.stdin.flush()

        _MCP_INITIALIZED = True

    except Exception:

        try: _MCP_PROC.kill()

        except Exception: pass

        _MCP_PROC = None

        _MCP_INITIALIZED = False

        return {}

    ids = set(range(2, 2 + len(calls)))

    results, deadline = {}, time.monotonic() + timeout

    while ids:

        left = deadline - time.monotonic()

        if left <= 0: break

        try: msg = _MCP_QUEUE.get(timeout=left)

        except queue.Empty: break

        if msg.get("id") not in ids: continue

        ids.discard(msg["id"])

        raw = msg.get("result",{}).get("content",[])

        for item in raw:

            if isinstance(item,dict) and item.get("type")=="text":

                try: results[msg["id"]] = json.loads(item["text"])

                except Exception: results[msg["id"]] = item["text"]

                break

        else:

            results[msg["id"]] = raw

    if ids:  # timeout -> drop process so stale responses never leak into next batch

        try: _MCP_PROC.kill()

        except Exception: pass

        _MCP_PROC = None

        _MCP_INITIALIZED = False

    return results



def keyword_search(question):

    keywords = re.findall(r'[a-zA-Ząćę?�?�???�????ĄĆ�??????�?�???�]{4,}', question.lower())

    if not keywords: return []

    calls = [("search_notes", {"query": kw, "limit": 5, "threshold": 0.0, "notes_prefix": "best you/"})

             for kw in keywords[:5]]

    res = _mcp_batch(calls)  # all in parallel, one write

    seen = {}

    for idx, r in res.items():

        for item in r if isinstance(r, list) else []:

            p = item.get("path","") if isinstance(item,dict) else ""

            s = item.get("similarity",0) if isinstance(item,dict) else 0

            if p.startswith("best you/"):

                if p in seen: seen[p] = max(seen[p], s)

                else: seen[p] = s

    return sorted(seen.items(), key=lambda x: -x[1])[:8]



def call_llm(messages, max_tokens=8192, stream=True):

    """Chat completion. stream=True: prints deltas to stdout. Returns (text, usage)."""

    body = json.dumps({"model":LLM_MODEL, "stream":stream,

        "messages":messages, "max_tokens":max_tokens, "temperature":0.3}).encode()

    headers = {"Content-Type":"application/json"}

    if LLM_KEY: headers["Authorization"]=f"Bearer {LLM_KEY}"

    parts, usage = [], {}

    try:

        req = urllib.request.Request(

            f"{LLM_BASE.rstrip('/')}/chat/completions", data=body, headers=headers, method="POST")

        with urllib.request.urlopen(req, timeout=120) as resp:

            if not stream:

                try:

                    data = json.loads(resp.read().decode())

                    usage = data.get("usage", {})

                    text = data["choices"][0]["message"].get("content","").strip()

                    return text or "(empty)", usage

                except Exception as e:

                    text = f"[error: {e}]"

                    if not usage:

                        usage = {"prompt_tokens": count_tokens(json.dumps(messages, ensure_ascii=False)),

                                 "completion_tokens": 0}

                    return text, usage

            for raw in resp:

                line = raw.decode("utf-8", "replace").strip()

                if not line.startswith("data:"): continue

                data = line[5:].strip()

                if data == "[DONE]": break

                try:

                    chunk = json.loads(data)

                    if chunk.get("usage"): usage = chunk["usage"]

                    delta = chunk["choices"][0]["delta"].get("content","")

                except Exception:

                    continue

                if delta:

                    parts.append(delta)

                    print(delta, end="", flush=True)

            if parts: print(file=sys.stdout, flush=True)

    except Exception as e:

        text = "".join(parts).strip() or f"[error: {e}]"

        return text, usage

    text = "".join(parts).strip()

    if not usage:  # router without usage chunk -> local estimate (bge tokenizer)

        usage = {"prompt_tokens": count_tokens(json.dumps(messages, ensure_ascii=False)),

                 "completion_tokens": count_tokens(text)}

    return text, usage



# ── process question ────────────────────────────────────────────────────

def gather_candidates(question, store):

    """Deterministic retrieval → ranked candidate list."""

    top10 = store.search(question, k=10)

    kw = keyword_search(question)

    kw_map = {p: s for p, s in kw}

    seen_p = set()

    merged = []

    for p, s in top10:

        seen_p.add(p)

        merged.append((p, s + (0.1 if p in kw_map else 0), "embed"))

    for p, s in kw:

        if p not in seen_p:

            merged.append((p, s * 0.7, "keyword"))

    merged.sort(key=lambda x: -x[1])

    return merged



def _norm(s):

    import unicodedata

    return unicodedata.normalize("NFKD", s).casefold()



# ?? Tree index (parsed once; branch + ancestor chain per note) ??

_TREE = None

def tree_index():

    global _TREE

    if _TREE is not None: return _TREE

    _TREE = {"branch": {}, "depth": {}, "chain": {}}

    try: lines = TREE_INDEX.read_text(encoding="utf-8").splitlines()

    except Exception: return _TREE

    stack = []

    for ln in lines:

        if not ln.strip().startswith("- "): continue

        depth = (len(ln) - len(ln.lstrip(" "))) // 2

        stem = _norm(ln.strip()[2:].strip().removesuffix(".md"))

        while stack and stack[-1][0] >= depth: stack.pop()

        parents = [st for _, st in stack]

        _TREE["branch"][stem] = parents[0] if parents else stem

        _TREE["depth"][stem] = depth

        _TREE["chain"][stem] = parents

        stack.append((depth, stem))

    return _TREE



_TOK = None

def count_tokens(text):

    """Real tokenizer count (no truncation). One extra bare Tokenizer, ~ms load."""

    global _TOK

    if _TOK is None:

        _TOK = Tokenizer.from_file(str(_SNAP_DIR / "tokenizer.json"))

        _TOK.no_truncation(); _TOK.no_padding()  # tokenizer.json embeds 512/trunc

    return len(_TOK.encode(text).ids)



def select_files(question, merged, store, token_budget=TOKEN_BUDGET, lam=0.75):

    """MMR greedy: relevance + diversity, token-capped. No LLM, deterministic.



    Marginal value = lam*score - (1-lam)*max_sim_to_picked (cosine in embedding space).

    lam~0.7-0.8: bias toward relevance; lower lam = more diversity.

    Hard gate: sim > DUP_THRESH to any picked -> eliminated (MMR alone is too soft).

    """

    vec_map = dict(zip(store.paths, store.vecs))

    cand = []

    for path, score, _ in sorted(merged, key=lambda x: -x[1]):

        name = Path(path).name

        if name in ("instructions.md", "AGENTS.md"): continue  # layer 0, not artifacts

        fn = NOTES_DIR / name

        if fn.suffix != ".md" or not fn.is_file(): continue

        cand.append((path, score, vec_map.get(path)))

    picked, picked_vecs, used, n_cache = [], [], 0, {}

    def _size(p):

        if p not in n_cache:

            n_cache[p] = count_tokens((NOTES_DIR / Path(p).name).read_text(encoding="utf-8"))

        return n_cache[p]

    # Pass 1: greedy MMR until budget refuses -> mark overflow candidates instead of dropping

    overflow = []

    while cand:

        best_i, best_val = -1, float("-inf")

        for i, (path, score, vec) in enumerate(cand):

            if vec is not None and picked_vecs:

                max_sim = max((v @ vec for v in picked_vecs))

                if max_sim > DUP_THRESH: continue  # hard gate: near-identical -> eliminate

                pen = max_sim

            else:

                pen = 0.0

            val = lam * score - (1 - lam) * pen

            if val > best_val:

                best_val, best_i = val, i

        if best_i < 0:

            break  # all remaining are near-duplicates -> nothing more to add

        path, score, vec = cand.pop(best_i)

        n = _size(path)

        if used + n > token_budget:

            overflow.append((path, score, vec, n))

            continue

        picked.append((path, n))

        if vec is not None: picked_vecs.append(vec)

        used += n

    # Pass 2: cheapest-to-add that still fits and has positive marginal value

    overflow.sort(key=lambda x: x[3])

    for path, score, vec, n in overflow:

        if used + n > token_budget:

            continue  # still too big -> abandon

        if vec is not None and picked_vecs:

            max_sim = max((v @ vec for v in picked_vecs))

            if max_sim > DUP_THRESH: continue

            val = lam * score - (1 - lam) * max_sim

        else:

            val = lam * score

        if val <= 0:

            continue  # positive-marginal gate: skip negative-value fills

        picked.append((path, n))

        if vec is not None: picked_vecs.append(vec)

        used += n

    if not picked and merged:

        fn = NOTES_DIR / Path(merged[0][0]).name

        if fn.is_file(): picked = [(merged[0][0], count_tokens(fn.read_text(encoding="utf-8")))]

    return picked



def build_kb_context(question, store):

    """Deterministic candidates -> branch-capped selection -> read -> context.



    Layers: 0 = system prompt (instructions.md), 2 = SCOPE header (task contract),

    4 = note content (token-capped working artifacts).

    """

    merged = gather_candidates(question, store)

    selected = select_files(question, merged, store)

    score_map = {p: s for p, s, _ in merged}

    ti = tree_index()

    notes_content = []

    used = 0

    for path, n in selected:

        fn = NOTES_DIR / Path(path).name

        if fn.suffix != ".md" or not fn.is_file(): continue

        stem = _norm(Path(path).stem)

        chain = ti["chain"].get(stem, [])

        via = " \u2192 ".join(chain) if chain else ""

        notes_content.append((path, score_map.get(path, 0), via, fn.read_text(encoding="utf-8").strip(), n))

        used += n

    ctx = []

    branches = sorted({ti["branch"].get(_norm(Path(p).stem), _norm(Path(p).stem)) for p, _ in selected})

    ctx.append(f"=== SCOPE (layer 2) ===\nbudget: {used}/{TOKEN_BUDGET} tokens | notes: {len(notes_content)} | branches: {', '.join(branches)}")

    top_str = "\n".join(f"  {s:.3f} [{src}] {p}" for p, s, src in merged[:10])

    ctx.append(f"=== CANDIDATES ===\n{top_str}")

    for path, score, via, content, n in notes_content:

        head = f"=== {path} (score={score:.3f}, {n} tok)"

        if via: head += f" | via: {via}"

        ctx.append(head + " ===\n" + content)

    return "\n\n".join(ctx)



def ensure_fresh_embeddings():

    """Rebuild embeddings.json when any note is newer than it."""

    newest = max((f.stat().st_mtime for f in NOTES_DIR.glob("*.md")), default=0.0)

    if EMBEDDINGS.is_file() and EMBEDDINGS.stat().st_mtime >= newest:

        return True

    print("  embeddings.json missing or stale (notes newer) - rebuilding...", file=sys.stderr)

    try:

        env = {**os.environ, "PYTHONIOENCODING": "utf-8"}

        r = subprocess.run([sys.executable, str(BASE / "programs" / "build-embeddings")],

                           capture_output=True, text=True, timeout=120, env=env)

    except subprocess.TimeoutExpired:

        print("  rebuild timed out", file=sys.stderr)

        return False

    if r.returncode != 0 or not EMBEDDINGS.is_file():

        print(f"  rebuild failed: {(r.stderr or r.stdout).strip()[:300]}", file=sys.stderr)

        return False

    return True



def main():

    header = f"  KB chat  |  {LLM_MODEL}  |  /help  /reset  /model  quit"

    print(f"\n{header}", file=sys.stderr)

    print("  " + "─"*60, file=sys.stderr)



    if not ensure_fresh_embeddings():

        if not EMBEDDINGS.is_file():

            print("  embeddings.json missing and rebuild failed; run programs/build-embeddings manually", file=sys.stderr)

            sys.exit(1)

        print("  continuing with stale embeddings", file=sys.stderr)

    store = NoteStore()

    print("  Embeddings loaded.\n", file=sys.stderr)



    # Load instructions

    sys_prompt = "Jesteś asystentem bazy wiedzy o samodyscyplinie. Odpowiadaj na podstawie notatek. Cytuj nazwę notki. Punktory. Terski. Pytanie po polsku → odpowiedź po polsku."

    if INSTRUCT.is_file():

        sys_prompt = INSTRUCT.read_text(encoding="utf-8").strip()

        print(f"  Loaded instructions.md ({len(sys_prompt)} chars)", file=sys.stderr)



    messages = [{"role": "system", "content": sys_prompt}]

    MAX_TURNS = 4  # sliding window: auto-drop oldest pairs beyond this



    while True:

        try:

            q = input("> ").strip()

        except (EOFError, KeyboardInterrupt):

            print(file=sys.stderr); break



        if not q: continue

        if q.lower() in ("quit","exit","q"): break



        # Commands

        if q.startswith("/"):

            cmd = q[1:].lower()

            if cmd == "reset":

                messages = [{"role": "system", "content": sys_prompt}]

                print("  context reset\n", file=sys.stderr); continue

            if cmd == "help":

                print("  /reset   — clear conversation context", file=sys.stderr)

                print("  /compact — summarize old turns, keep last 4", file=sys.stderr)

                print("  /model   — show current LLM model", file=sys.stderr)

                print("  quit     — exit\n", file=sys.stderr); continue

            if cmd == "compact":

                non_sys = messages[1:]

                if len(non_sys) <= MAX_TURNS * 2:

                    print("  nothing to compact (keep last 4 turns)\n", file=sys.stderr); continue

                keep = non_sys[-MAX_TURNS * 2:]

                old_m = non_sys[:-MAX_TURNS * 2]

                print(f"  summarizing {len(old_m)//2} turns…", file=sys.stderr)

                summary, _ = call_llm([{"role":"system","content":sys_prompt},

                    {"role":"user","content":"Podsumuj TĘ rozmowę tersko, punktami. Zachowaj fakty, wnioski i nazwy notatek. Kontekst zostanie usunięty:\n\n" + json.dumps(old_m, ensure_ascii=False)}], max_tokens=500, stream=False)

                messages[:] = [messages[0],

                    {"role": "system", "content": "Podsumowanie wcześniejszej rozmowy:\n" + summary}] + keep

                print(f"  compacted to {len(keep)//2} turns + summary\n", file=sys.stderr); continue

            if cmd == "model":

                print(f"  model: {LLM_MODEL}", file=sys.stderr); continue

            print(f"  unknown: {q}\n", file=sys.stderr); continue



        # Build context from KB

        print("  searching…", file=sys.stderr)

        kb_ctx = build_kb_context(q, store)



        # User message = question + KB context

        user_msg = f"Pytanie: {q}\n\nNotatki:\n\n{kb_ctx}"

        messages.append({"role": "user", "content": user_msg})



        # LLM (streams to stdout)

        t_llm = time.monotonic()

        ans, usage = call_llm(messages, max_tokens=8192)

        dt_llm = time.monotonic() - t_llm



        # Store response

        messages.append({"role": "assistant", "content": ans})



        # Sliding window: drop oldest turns beyond MAX_TURNS

        while len([m for m in messages if m["role"] != "system"]) > MAX_TURNS * 2:

            messages.pop(1); messages.pop(1)



        print("\n", end="", file=sys.stderr)

        pt, ct = usage.get("prompt_tokens", "?"), usage.get("completion_tokens", "?")

        print(f"  [prompt {pt} | completion {ct} tok | {dt_llm:.1f}s]", file=sys.stderr)

        print("", file=sys.stderr)



def _once(q):
    if not ensure_fresh_embeddings() and not EMBEDDINGS.is_file(): sys.exit(1)
    store = NoteStore()
    sys_prompt = INSTRUCT.read_text(encoding="utf-8").strip() if INSTRUCT.is_file() else ""
    kb = build_kb_context(q, store)
    user = "Pytanie: " + q + chr(10) + chr(10) + "Notatki:" + chr(10) + chr(10) + kb
    msgs = [{"role":"system","content":sys_prompt}, {"role":"user","content":user}]
    ans, usage = call_llm(msgs)
    print()
    pt, ct = usage.get("prompt_tokens","?"), usage.get("completion_tokens","?")
    print("  [prompt " + str(pt) + " | completion " + str(ct) + " tok]", file=sys.stderr)

if __name__ == "__main__":
    if len(sys.argv) > 1:
        _once(" ".join(sys.argv[1:]))
    else:
        main()
